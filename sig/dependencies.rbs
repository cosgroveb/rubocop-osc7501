# Dependency APIs used by the adapter that are absent from bundled RBS.
module RuboCop
  class Version
    STRING: String
  end
end

module Gem
  class BasicSpecification
    def full_gem_path: () -> String
    def cache_file: () -> String
  end

  class Specification
    def self.find_all_by_name: (String) -> Array[Specification]
    def self.find_by_name: (String) -> Specification
    def self.attribute_names: () -> Array[Symbol]
    def self.any?: () -> bool
                 | () { (Specification) -> boolish } -> bool
    def bindir: () -> String
    def default_gem?: () -> bool
    def name: () -> String
    def runtime_dependencies: () -> Array[Gem::Dependency]
  end

  class Package
    def initialize: (String) -> void
    def verify: () -> bool
    def spec: () -> Specification

    class TarReader
      include Enumerable[Entry]
      def self.new: [T] (IO | StringIO) { (TarReader) -> T } -> T
      def each: () { (Entry) -> void } -> void

      class Entry
        def full_name: () -> String
        def read: () -> String
        def header: () -> TarHeader
      end
    end

    class TarHeader
      def typeflag: () -> String
      def mode: () -> Integer
      def linkname: () -> String
    end
  end
end

class Gem::Dependency
  def name: () -> String
end

module Process
  def self.spawn: (untyped environment, *String command, **untyped options) -> Integer
end

module Open3
  def self.capture3: (Hash[String, String?] | String, *String, ?stdin_data: String, ?chdir: String) -> [String, String, Process::Status]
end

module Zlib
  class GzipReader
    def self.wrap: [T] (StringIO) { (GzipReader) -> T } -> T
  end
end
